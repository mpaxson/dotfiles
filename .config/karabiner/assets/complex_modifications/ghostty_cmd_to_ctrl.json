{
  "title": "Command to Control in Ghostty",
  "rules": [
    {
      "description": "Map left_command to left_control in Ghostty",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_command",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            { "key_code": "left_control" }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com.mitchellh.ghostty$"
              ]
            }
          ]
        }
      ]
    }
  ]
}
